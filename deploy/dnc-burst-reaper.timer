# Runs the burst reaper on a short interval. The idle TTL is only as tight as this cadence,
# so keep it well under BURST_IDLE_TTL_S.
[Unit]
Description=Run the divide-and-conquer burst reaper every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
